# Published release image - not used for local dev (no live reload, no
# dev/test tooling), see ./Dockerfile for that. Serves as the api service;
# override the command to run it as the worker instead (bundle exec
# sidekiq -r ./config/boot.rb) - same image, same gems either way.

FROM ruby:4.0-slim

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libssl-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Gemfile Gemfile.lock* ./
RUN bundle config set --local without 'development cli test' && \
    bundle install --jobs 4 --retry 3

COPY . .

ENV HANAMI_ENV=production
EXPOSE 2300

CMD ["bundle", "exec", "hanami", "server"]
