# Published release image - not used for local dev, see ./Dockerfile for
# that. VITE_API_BASE_URL is intentionally not set here: the built bundle
# reads window.__APP_CONFIG__ instead, injected at container startup from
# the API_BASE_URL env var (see docker/docker-entrypoint.sh), so the same
# image works against whatever backend URL the person running it points
# it at.

FROM node:22-slim AS build

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .
RUN npm run build

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/config.template.js /etc/nginx/templates/config.template.js
COPY docker/docker-entrypoint.sh /docker-entrypoint.d/40-inject-config.sh
RUN chmod +x /docker-entrypoint.d/40-inject-config.sh

EXPOSE 80
